    title: "OWASP Mobile Application Security Testing Guide (MASTG)"
    authors: ["OWASP Foundation"]
    url: "https://mas.owasp.org/MASTG/"
  - type: standard
    title: "NIST SP 800-163 Rev.1 — Vetting the Security of Mobile Applications"
    authors: ["National Institute of Standards and Technology"]
    url: "https://doi.org/10.6028/NIST.SP.800-163r1"
